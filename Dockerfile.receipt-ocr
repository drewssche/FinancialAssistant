FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OCR_MODEL_DIR=/models OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /worker
COPY receipt_ocr/requirements.txt /worker/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY receipt_ocr /worker/receipt_ocr
RUN python -m receipt_ocr.models && useradd --system --uid 10001 ocr
USER 10001
CMD ["python", "-m", "receipt_ocr.server"]
